# Copy this file to .env.local and fill in local-only values.
# .env.local is ignored by Git and must never be committed.

# Tavily MCP search API key.
# - .mcp.json (Claude Code) reads it via ${TAVILY_API_KEY} — export it in your shell / .env.local.
# - Codex reads it from the untracked .codex/config.toml (copy from .codex/config.toml.example).
TAVILY_API_KEY=<TAVILY_API_KEY>

# AList API used by local maintenance scripts.
ALIST_URL=https://<ALIST_PUBLIC_OR_INTERNAL_HOST>
ALIST_LOCAL_URL=http://127.0.0.1:5244
ALIST_USERNAME=<ALIST_USERNAME>
ALIST_PASSWORD=<ALIST_PASSWORD>

# Optional SSH target for manual server-side upload/release maintenance.
FILTER_MANAGE_SSH_KEY=<SSH_KEY_PATH>
FILTER_MANAGE_SSH_TARGET=<SSH_USER>@<SERVER_HOST>

# GitHub Actions equivalents must be configured as GitHub Secrets,
# not copied into workflow files.
UPLOAD_WEBHOOK_URL=<UPLOAD_WEBHOOK_URL>
UPLOAD_SECRET=<UPLOAD_SECRET>
UPDATE_API_URL=<UPDATE_API_URL>
UPDATE_RELEASE_SECRET=<UPDATE_RELEASE_SECRET>
TAURI_SIGNING_PRIVATE_KEY=<TAURI_SIGNING_PRIVATE_KEY>
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=<TAURI_SIGNING_PRIVATE_KEY_PASSWORD>
