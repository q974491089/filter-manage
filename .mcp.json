{
  "mcpServers": {
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "codegraph": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "C:\\Users\\Administrator\\AppData\\Roaming\\npm\\codegraph.cmd",
        "serve",
        "--mcp",
        "--path",
        "C:\\Users\\myuser\\Projects\\filter-manage"
      ]
    }
  }
}
